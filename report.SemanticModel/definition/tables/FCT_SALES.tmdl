table FCT_SALES
	lineageTag: 6bf9a502-5906-43d3-9706-4190b10ac772

	measure 'Net Sales' = SUM(FCT_SALES[GROSS_SALES_AMOUNT]) - SUM(FCT_SALES[DISCOUNT_AMOUNT])
		formatString: #,0.00
		displayFolder: 01 Base Measures
		lineageTag: bc6b44be-9f55-4d42-9179-36ca634ce0d2

	measure Transactioncount = DISTINCTCOUNT(FCT_SALES[TRANSACTION_ID])
		formatString: #,0
		displayFolder: 01 Base Measures
		lineageTag: a413b4ec-ca5f-4625-b36c-df01fcabf161

	measure 'Trading Metric' = [Net Sales]
		formatString: #,0.00
		displayFolder: 02 Reporting
		lineageTag: c53374b8-fb2a-40a3-880b-b05d79adc629

	measure 'YoY Status' =
			VAR RunningColumn = SELECTEDVALUE('Running Columns'[Column])
			VAR TemplateColumn = SELECTEDVALUE('Template Columns'[Column])
			VAR Comparison = IF(TemplateColumn IN {"YoY", "YoY %"}, TemplateColumn, SWITCH(RunningColumn, "YoY Running Total", "YoY", "YoY % Running Total", "YoY %", SELECTEDVALUE('Time Comparison'[Comparison])))
			VAR _Scope = IF(NOT ISBLANK(RunningColumn), "Quarter Running Total", SELECTEDVALUE('Period Scope'[Scope], "Selected QTD"))
			VAR MetricName = SELECTEDVALUE('Metric'[Metric], "Net Sales")
			VAR QStart = SELECTEDVALUE('Quarter Selector'[Quarter Start])
			VAR QEnd = SELECTEDVALUE('Quarter Selector'[Quarter End])
			VAR Cutoff = MAX('Report Settings'[As Of Date])
			VAR CellDates = VALUES(DIM_DATE[CALENDAR_DATE])
			VAR PointDate = MAX(DIM_DATE[CALENDAR_DATE])
			VAR WindowStart = IF(_Scope = "Previous 2 Quarters", EDATE(QStart, -6), QStart)
			VAR WindowEnd = SWITCH(_Scope, "Previous 2 Quarters", QStart-1, "Quarter Running Total", MIN(PointDate, MIN(QEnd, Cutoff)), MIN(QEnd, Cutoff))
			VAR DateRows = FILTER(ALL(DIM_DATE), DIM_DATE[CALENDAR_DATE] >= WindowStart && DIM_DATE[CALENDAR_DATE] <= WindowEnd
			    && (_Scope = "Quarter Running Total" || CONTAINS(CellDates, DIM_DATE[CALENDAR_DATE], DIM_DATE[CALENDAR_DATE])))
			VAR CurrentDates = SELECTCOLUMNS(DateRows, "Date", DIM_DATE[CALENDAR_DATE])
			VAR PriorDates = SELECTCOLUMNS(FILTER(DateRows, NOT ISBLANK(DIM_DATE[PY_COMPARABLE_DATE])), "Date", DIM_DATE[PY_COMPARABLE_DATE])
			VAR Covered = COUNTROWS(CurrentDates) > 0 && COUNTROWS(CurrentDates) = COUNTROWS(PriorDates)
			    && MINX(PriorDates, [Date]) >= MAX('Report Settings'[Data Start Date])
			    && MAXX(PriorDates, [Date]) <= MAX('Report Settings'[Data End Date])
			VAR CY = CALCULATE(SWITCH(MetricName, "Net Sales", [Net Sales], "Units", [Units], "Transactioncount", [Transactioncount], "ABV", DIVIDE([Net Sales], [Transactioncount]), "UPT", DIVIDE([Units], [Transactioncount]), "Discount %", DIVIDE(SUM(FCT_SALES[DISCOUNT_AMOUNT]), SUM(FCT_SALES[GROSS_SALES_AMOUNT])), "Gross Sales", SUM(FCT_SALES[GROSS_SALES_AMOUNT]), "Discount", SUM(FCT_SALES[DISCOUNT_AMOUNT]), "ASP", DIVIDE([Net Sales], [Units]), "Active Locations", COUNTROWS(FILTER(VALUES(DIM_LOCATION[LOCATION_ID]),
			    VAR Sales = CALCULATE([Net Sales])
			    RETURN NOT ISBLANK(DIM_LOCATION[LOCATION_ID]) && NOT ISBLANK(Sales) && Sales <> 0)), "Sales per Location", DIVIDE([Net Sales], COUNTROWS(FILTER(VALUES(DIM_LOCATION[LOCATION_ID]),
			    VAR Sales = CALCULATE([Net Sales])
			    RETURN NOT ISBLANK(DIM_LOCATION[LOCATION_ID]) && NOT ISBLANK(Sales) && Sales <> 0))), BLANK()), REMOVEFILTERS(DIM_DATE), TREATAS(CurrentDates, DIM_DATE[CALENDAR_DATE]))
			VAR PY = CALCULATE(SWITCH(MetricName, "Net Sales", [Net Sales], "Units", [Units], "Transactioncount", [Transactioncount], "ABV", DIVIDE([Net Sales], [Transactioncount]), "UPT", DIVIDE([Units], [Transactioncount]), "Discount %", DIVIDE(SUM(FCT_SALES[DISCOUNT_AMOUNT]), SUM(FCT_SALES[GROSS_SALES_AMOUNT])), "Gross Sales", SUM(FCT_SALES[GROSS_SALES_AMOUNT]), "Discount", SUM(FCT_SALES[DISCOUNT_AMOUNT]), "ASP", DIVIDE([Net Sales], [Units]), "Active Locations", COUNTROWS(FILTER(VALUES(DIM_LOCATION[LOCATION_ID]),
			    VAR Sales = CALCULATE([Net Sales])
			    RETURN NOT ISBLANK(DIM_LOCATION[LOCATION_ID]) && NOT ISBLANK(Sales) && Sales <> 0)), "Sales per Location", DIVIDE([Net Sales], COUNTROWS(FILTER(VALUES(DIM_LOCATION[LOCATION_ID]),
			    VAR Sales = CALCULATE([Net Sales])
			    RETURN NOT ISBLANK(DIM_LOCATION[LOCATION_ID]) && NOT ISBLANK(Sales) && Sales <> 0))), BLANK()), REMOVEFILTERS(DIM_DATE), TREATAS(PriorDates, DIM_DATE[CALENDAR_DATE]))
			VAR Delta = CY-PY
			VAR ChangeValue = IF(Covered && NOT(ISBLANK(CY) && ISBLANK(PY)) && Comparison IN {"YoY", "YoY %"}, IF(Comparison = "YoY %", DIVIDE(Delta, PY), Delta))
			VAR Adverse = MetricName IN {"Discount", "Discount %"}
			RETURN IF(ISBLANK(ChangeValue), "#303638", IF(ChangeValue = 0, "#6B7280", IF(IF(Adverse, -ChangeValue, ChangeValue) > 0, "#188038", "#C62828")))
		formatString: General
		displayFolder: 99 Formatting
		lineageTag: 834b1b4f-7f94-4807-b279-7ee52cf666bb

