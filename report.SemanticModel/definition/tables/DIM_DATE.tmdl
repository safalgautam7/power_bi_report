	column 'ISO Year Week' = FORMAT(DIM_DATE[ISO_WEEK_YEAR], "0000") & "-W" & FORMAT(DIM_DATE[ISO_WEEK_NUMBER], "00")
		dataType: string
		lineageTag: db771159-f753-43aa-9a5b-d6e3712f5766
		summarizeBy: none
		sortByColumn: ISO_WEEK_KEY

	column 'Template Month' = FORMAT(DIM_DATE[CALENDAR_DATE], "MMM yyyy")
		dataType: string
		lineageTag: c6550f4a-8b60-4285-9597-400b47862f9b
		summarizeBy: none
		sortByColumn: YEAR_MONTH_KEY

	column 'Template Week' = "W" & FORMAT(DIM_DATE[ISO_WEEK_NUMBER], "00") & IF(DIM_DATE[ISO_WEEK_YEAR] <> DIM_DATE[CALENDAR_YEAR], " (" & FORMAT(DIM_DATE[ISO_WEEK_YEAR], "0000") & ")", "")
		dataType: string
		lineageTag: 2fa5a65b-abfb-49eb-b297-6b835943642f
		summarizeBy: none
		sortByColumn: 'Template Week Sort'

	column 'Template Week Sort' = SWITCH(TRUE(), DIM_DATE[ISO_WEEK_YEAR] < DIM_DATE[CALENDAR_YEAR], 0, DIM_DATE[ISO_WEEK_YEAR] > DIM_DATE[CALENDAR_YEAR], 54, DIM_DATE[ISO_WEEK_NUMBER])
		dataType: int64
		isHidden
		lineageTag: fb71dc5f-4fa6-45c2-a7ea-9990f24c1715
		summarizeBy: none

	/// Used only by the Running Total chart X axes.
	column 'Running Day of Quarter' = DATEDIFF(DIM_DATE[QUARTER_START_DATE], DIM_DATE[CALENDAR_DATE], DAY) + 1
		dataType: int64
		isHidden
		lineageTag: f8073463-ad78-4b70-a391-295fdca8ccb8
		summarizeBy: none

	partition DIM_DATE = m
		mode: import
