				    RETAIL_DWH_Database = Source{[Name="RETAIL_DWH",Kind="Database"]}[Data],
				    MART_SALES_Schema = RETAIL_DWH_Database{[Name="MART_SALES",Kind="Schema"]}[Data],
				    DIM_DATE_View = MART_SALES_Schema{[Name="DIM_DATE",Kind="View"]}[Data]
				in
				    DIM_DATE_View

	annotation PBI_ResultType = Table

