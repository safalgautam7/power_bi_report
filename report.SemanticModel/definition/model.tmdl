model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DIM_DATE","DIM_ITEM","DIM_LOCATION","FCT_SALES"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIM_DATE
ref table DIM_ITEM
ref table DIM_LOCATION
ref table FCT_SALES
ref table 'Report Settings'
ref table 'Quarter Selector'
ref table 'Top N'
ref table 'Department Axis'
ref table Metric
ref table 'Time Comparison'
ref table 'Period Scope'
ref table 'Running Columns'
ref table 'Template Columns'
ref table 'Running Layout'
ref table 'Running Dates'

ref cultureInfo en-US

